<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ══════════════════════════════════════════════════════════════════
         AĞ KAPISI İZİNLERİ — "yalnızca hastane WiFi'ında çalış" kuralı için.
         Ayrıntı: AGENTS.md §4. ÖNEMLİ: SSID okumak için cihazın Konum
         Servisleri'nin AÇIK olması gerekir (izin vermek tek başına yetmez).
         ══════════════════════════════════════════════════════════════════ -->

    <!-- WiFi bağlantı bilgisini okumak (tüm API seviyeleri). Normal izin. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Android 12+ (API 31+): aktif ağı çözüp SSID/BSSID almak için. Normal izin. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Bağlı ağın SSID/BSSID'i (WifiManager.getConnectionInfo) HER API
         seviyesinde ACCESS_FINE_LOCATION ister — Android 13+ dahil.
         NEARBY_WIFI_DEVICES bunun yerini GEÇMEZ; ek olarak istenir.
         maxSdkVersion KOYULMAZ: 33+'ta kaldırılırsa getWifiName() kalıcı
         olarak <unknown ssid> döner ve kapı hiçbir zaman açılmaz. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Android 13+ (API 33+): connection-info (SSID/BSSID) okumasında
         ACCESS_FINE_LOCATION'a EK OLARAK istenir (yerine geçmez).

         ⚠️ `neverForLocation` BİLEREK KULLANILMIYOR: bu uygulama WiFi bilgisini
         "kullanıcı fiziksel olarak hastanede mi?" sorusunu yanıtlamak için, yani
         KONUM ÇIKARIMI amacıyla kullanır. Bu bayrak "WiFi'den konum türetmiyorum"
         beyanıdır ve bizim için YANLIŞ beyan olurdu (Play Store politikası).
         Kaynak: developer.android.com/develop/connectivity/wifi/wifi-permissions -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <!-- Intranet erişilebilirlik kontrolü + veri çekme. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Kapari Hazır Yemek"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
